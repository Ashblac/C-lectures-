#include <iostream>
using namespace std;

class Quadrilateral {
private:
    int width;
    int height;

public:
    // Setters
    void setWidth(int w) {
        width = w;
    }

    void setHeight(int h) {
        height = h;
    }

    // Check if square or rectangle
    void printType() {
        if (width == height) {
            cout << "Type: Square" << endl;
        } else {
            cout << "Type: Rectangle" << endl;
        }
    }

    void printArea() {
        cout << "Area: " << width * height << endl;
    }

    // Drawing with nested loops
    void draw() {
        for (int i = 0; i < height; i++) {
            for (int j = 0; j < width; j++) {
                cout << "* ";
            }
            cout << endl;
        }
    }
};

int main() {
    int width, height;
    char choice = 'C';
    Quadrilateral quadrilateral;

    do {
        cout << "Enter the height and width: ";
        cin >> height >> width;
        
        quadrilateral.setWidth(width);
        quadrilateral.setHeight(height);
        
        quadrilateral.printType();
        quadrilateral.printArea();
        quadrilateral.draw();

        cout << "Enter a choice: Q(Quit) or another letter to resize: ";
        cin >> choice;

    } while (choice != 'Q' && choice != 'q');

    return 0;
}
