    Circle* circle1 = new Circle(x, y, radius);

    cout << "Enter x, y and radius respectively for the second circle: ";
    cin >> x >> y >> radius;
    Circle* circle2 = new Circle(x, y, radius);

    circle1->move(2, 3);

