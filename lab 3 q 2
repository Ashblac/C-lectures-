        cout << "Circle 1 is larger than Circle 2" << endl;
    } else {
        cout << "Circle 1 is not larger than Circle 2" << endl;
    }

    double dist = circle1->calculateDistance(*circle2);
    cout << "The distance between the centers of Circle 1 and Circle 2 is: " << dist << endl;
    
