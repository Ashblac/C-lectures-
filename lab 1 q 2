#include <iostream>
using namespace std;

// Function 1: Swaps using pointers (requires dereferencing)
void swapUsingPointers(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Function 2: Swaps using references (syntax looks like normal variables)
void swapUsingPointers(int& a, int& b) {
    int temp = a;
    a = b;
    b = temp;
}

int main() {
    int num1, num2;

    cout << "Enter two integers: ";
    cin >> num1 >> num2;

    cout << "\nOriginal values: num1 = " << num1 << ", num2 = " << num2 << endl;

    // Call reference version
    swapUsingPointers(num1, num2);
    cout << "After swap using references: num1 = " << num1 << ", num2 = " << num2 << endl;

    // Call pointer version (must pass addresses using &)
    swapUsingPointers(&num1, &num2);
    cout << "After swap using pointers:   num1 = " << num1 << ", num2 = " << num2 << endl;

    return 0;
}
