#include <iostream>

int main() {
    using namespace std;
    int v1=5, v2=15;
    int *p1;
    int *p2;
    
    p1=&v1;
    p2=&v2;
    
    *p1=10;
    *p2=*p1;
    
    p1=p2;
    *p1=20;
    cout<<v1<<endl;//0x7ffe16cba22c-->0x7ffc1f24642c-->0x7fff27e5c43c-->0x7ffc310b1da8-->0x7ffdf2229b48
    cout<<v2<<endl;//0x7fff31d987a8-->0x7fff27e5c438-->0x7ffc310b1da8-->0x7ffdf2229b48
    

    return 0;
}
//v1-->5-->10-->10
